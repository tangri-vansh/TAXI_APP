+using SafeModeRiskZone = Costing::Options::SafeModeRiskZone;
+
+bool point_in_polygon(const PointLL& point, const SafeModeRiskZone& zone) {
+  bool inside = false;
+  const auto& vertices = zone.vertices();
+  if (vertices.size() < 4)
+    return false;
+
+  for (int i = 0, j = vertices.size() - 1; i < vertices.size(); j = i++) {
+    const double xi = vertices.Get(i).lon();
+    const double yi = vertices.Get(i).lat();
+    const double xj = vertices.Get(j).lon();
+    const double yj = vertices.Get(j).lat();
+    const bool crosses = ((yi > point.lat()) != (yj > point.lat())) &&
+                         (point.lng() < (xj - xi) * (point.lat() - yi) / (yj - yi) + xi);
+    if (crosses)
+      inside = !inside;
+  }
+  return inside;
+}
+
+bool edge_midpoint(const DirectedEdge* edge, const graph_tile_ptr& tile, PointLL& midpoint) {
+  if (!edge || !tile)
+    return false;
+  const auto shape = tile->edgeinfo(edge).shape();
+  if (shape.size() < 2)
+    return false;
+
+  double edge_length = 0.0;
+  for (size_t i = 1; i < shape.size(); ++i)
+    edge_length += shape[i - 1].Distance(shape[i]);
+  if (!std::isfinite(edge_length) || edge_length <= 0.0)
+    return false;
+
+  double remaining = edge_length / 2.0;
+  for (size_t i = 1; i < shape.size(); ++i) {
+    const double segment_length = shape[i - 1].Distance(shape[i]);
+    if (remaining <= segment_length) {
+      midpoint = shape[i - 1].PointAlongSegment(shape[i], remaining / segment_length);
+      return true;
+    }
+    remaining -= segment_length;
+  }
+  return false;
+}
+
+bool edge_risk(const DirectedEdge* edge,
+               const graph_tile_ptr& tile,
+               const std::vector<SafeModeRiskZone>& zones,
+               float& risk) {
+  PointLL midpoint;
+  if (!edge_midpoint(edge, tile, midpoint))
+    return false;
+  for (const auto& zone : zones) {
+    if (point_in_polygon(midpoint, zone)) {
+      risk = zone.normalized_risk();
+      return true;
+    }
+  }
+  return false;
+}
+
+Cost add_safe_mode_risk(Cost base_cost,
+                        const DirectedEdge* edge,
+                        const graph_tile_ptr& tile,
+                        const float beta,
+                        const std::vector<SafeModeRiskZone>& zones) {
+  if (beta <= 0.0f)
+    return base_cost;
+  float risk = 0.0f;
+  if (!edge_risk(edge, tile, zones, risk))
+    throw std::runtime_error("Safe Mode encountered an edge without risk-zone coverage");
+  base_cost.cost += beta * risk;
+  return base_cost;
+}
